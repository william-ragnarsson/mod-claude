# Optional. Both default to the site's own project (lib/supabase.ts). Set both to use another Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase dashboard → Project Settings → API Keys → Secret keys. Server-only, never commit.
SUPABASE_SECRET_KEY=
# Optional locally (60 GitHub requests/hour without it). Fine-grained token, public repos read-only.
GITHUB_TOKEN=
# Any long random string. Vercel cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
